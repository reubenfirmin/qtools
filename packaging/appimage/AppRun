#!/bin/sh
set -eu

appdir=${APPDIR:?AppImage runtime did not set APPDIR}
invoked=${ARGV0:-$0}
command_name=$(basename -- "$invoked")

version=$(cat "$appdir/usr/share/qtools/VERSION")
bin_dir=${HOME:?HOME is not set}/.local/bin
installed_image=$bin_dir/qtools.AppImage
state_dir=${XDG_STATE_HOME:-$HOME/.local/state}/qtools
snooze_seconds=2592000

usage() {
    cat <<EOF
qtools $version

Usage:
  $invoked --install       Install qtools, dq, and pq for this user
  qtools update            Update qtools from the stable AppImage channel
  qtools snooze-update-notification
                           Hide update notices for 30 days
  qtools uninstall         Remove the user installation
  qtools version           Show the installed version

Direct use:
  $invoked dq [ARGS...]
  $invoked pq [ARGS...]
EOF
}

now() { date +%s; }

snooze_update_notification() {
    mkdir -p -m 700 "$state_dir"
    printf '%s\n' "$(( $(now) + snooze_seconds ))" > "$state_dir/update-snoozed-until"
    echo "qtools: update notifications snoozed for 30 days"
}

link_command() {
    name=$1
    link=$bin_dir/$name
    if [ -e "$link" ] && [ ! -L "$link" ]; then
        echo "qtools: refusing to replace unrelated file: $link" >&2
        exit 1
    fi
    if [ -L "$link" ]; then
        destination=$(readlink "$link")
        if [ "$destination" != "qtools.AppImage" ]; then
            echo "qtools: refusing to replace unrelated symlink: $link -> $destination" >&2
            exit 1
        fi
    fi
    temporary=$bin_dir/.qtools-link-$$-$name
    ln -s qtools.AppImage "$temporary"
    mv -f "$temporary" "$link"
}

install_image() {
    source_image=${APPIMAGE:?AppImage runtime did not set APPIMAGE}
    mkdir -p "$bin_dir"
    temporary=$bin_dir/.qtools.AppImage.$$
    trap 'rm -f "$temporary"' EXIT HUP INT TERM
    cp "$source_image" "$temporary"
    chmod 0755 "$temporary"
    mv -f "$temporary" "$installed_image"
    trap - EXIT HUP INT TERM
    link_command qtools
    link_command dq
    link_command pq
    echo "Installed qtools $version to $installed_image"
    case :${PATH:-}: in
        *:"$bin_dir":*) ;;
        *) echo "Note: $bin_dir is not on PATH." ;;
    esac
}

update_image() {
    current=${APPIMAGE:?AppImage runtime did not set APPIMAGE}
    if command -v appimageupdatetool >/dev/null 2>&1; then
        if appimageupdatetool "$current"; then
            rm -f "$state_dir/update-available" "$state_dir/update-snoozed-until" 2>/dev/null || true
            return 0
        else
            return $?
        fi
    fi

    case "$(uname -m)" in
        x86_64|amd64) arch=x86_64 ;;
        aarch64|arm64) arch=aarch64 ;;
        *) echo "qtools: no AppImage release is available for $(uname -m)" >&2; exit 1 ;;
    esac

    asset=Qtools-$arch.AppImage
    base_url=https://repo.qtools.sh
    current_dir=$(dirname -- "$current")
    checksums=
    downloaded=$(mktemp "$current_dir/.qtools.AppImage.XXXXXX")
    trap 'rm -f "$downloaded" "$checksums"' EXIT HUP INT TERM
    checksums=$(mktemp "$current_dir/.qtools.SHA256SUMS.XXXXXX")

    if command -v curl >/dev/null 2>&1; then
        fetch() { curl --fail --location --proto '=https' --tlsv1.2 --silent --show-error --output "$2" "$1"; }
    elif command -v wget >/dev/null 2>&1; then
        fetch() { wget --https-only --quiet --output-document="$2" "$1"; }
    else
        echo "qtools: the full update requires curl or wget" >&2
        exit 1
    fi

    echo "appimageupdatetool not found; downloading the full $asset"
    fetch "$base_url/SHA256SUMS" "$checksums"
    fetch "$base_url/$asset" "$downloaded"

    expected=$(awk -v name="$asset" '$2 == name || $2 == "*" name { print $1; exit }' "$checksums")
    case "$expected" in
        *[!0-9a-fA-F]*|'')
            echo "qtools: SHA256SUMS does not contain a valid checksum for $asset" >&2
            exit 1
            ;;
    esac
    if [ "${#expected}" -ne 64 ]; then
        echo "qtools: SHA256SUMS does not contain a valid checksum for $asset" >&2
        exit 1
    fi
    actual=$(sha256sum "$downloaded" | awk '{print $1}')
    if [ "$actual" != "$expected" ]; then
        echo "qtools: checksum verification failed for $asset" >&2
        exit 1
    fi

    chmod 0755 "$downloaded"
    mv -f "$downloaded" "$current"
    rm -f "$checksums"
    trap - EXIT HUP INT TERM
    rm -f "$state_dir/update-available" "$state_dir/update-snoozed-until" 2>/dev/null || true
    echo "Updated qtools to the latest stable AppImage"
}

uninstall_image() {
    for name in qtools dq pq; do
        link=$bin_dir/$name
        if [ -L "$link" ] && [ "$(readlink "$link")" = "qtools.AppImage" ]; then
            rm "$link"
        fi
    done
    if [ -f "$installed_image" ]; then rm "$installed_image"; fi
    echo "Removed the qtools user installation"
}

case "$command_name" in
    dq|pq) exec "$appdir/usr/bin/$command_name" "$@" ;;
esac

case "${1:-}" in
    --install|install) install_image ;;
    update) update_image ;;
    snooze-update-notification) snooze_update_notification ;;
    uninstall) uninstall_image ;;
    version|--version|-V) echo "qtools $version" ;;
    dq|pq)
        selected=$1
        shift
        exec "$appdir/usr/bin/$selected" "$@"
        ;;
    help|--help|-h|"") usage ;;
    *) echo "qtools: unknown command '$1'" >&2; usage >&2; exit 2 ;;
esac
